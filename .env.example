# ─────────────────────────────────────────────
# VULNERABILITY RISK PRIORITIZATION SYSTEM
# Environment Variables — copy to .env and fill in
# ─────────────────────────────────────────────

# App
APP_NAME="VulnRisk Prioritization System"
APP_VERSION="1.0.0"
DEBUG=true

# Supabase Postgres — Project Settings -> Database -> Connection string (URI).
# Use the Session Pooler string (postgres.<ref>@aws-0-<region>.pooler.supabase.com:5432) —
# the direct db.<ref>.supabase.co host is IPv6-only and unreliable on many networks.
DATABASE_URL=postgresql://postgres.your-project-ref:your_db_password@aws-0-your-region.pooler.supabase.com:5432/postgres
# Project Settings -> API -> Project URL. Auth JWTs are verified against this
# project's public JWKS endpoint (app/core/security.py) — no shared secret needed.
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings -> API -> Project API keys -> anon/public. Safe to be
# public; used as the Storage API's `apikey` header (app/services/storage_service.py).
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Groq API (remediation suggestions / ticket description enhancer)
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# NVD API Key (get free key at: https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=your_nvd_api_key_here

# EPSS API (no key needed)
EPSS_API_BASE=https://api.first.org/data/v1/epss

# CISA KEV (local file path — placed in /data folder)
CISA_KEV_FILE=data/known_exploited_vulnerabilities.json

# ExploitDB (local CSV — placed in /data folder)
EXPLOITDB_CSV=data/files_exploits.csv

# GitHub OAuth App
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/github/callback

# Token Encryption Secret (any 32+ char random string)
SECRET_KEY=change_this_to_a_random_secret_key_min_32_chars

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Upload
MAX_UPLOAD_SIZE_MB=1024
UPLOAD_TEMP_DIR=tmp/uploads
